# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database (PostgreSQL) ---
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+psycopg2://aapdasaathi:CHANGE_ME@localhost:5432/aapdasaathi
# Separate database used only by pytest (tables are dropped and recreated on each run).
# Leave empty to run tests against in-memory SQLite.
TEST_DATABASE_URL=postgresql+psycopg2://aapdasaathi:CHANGE_ME@localhost:5432/aapdasaathi_test

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Initial administrator (read only by: python -m app.database.seed_admin) ---
ADMIN_EMAIL=admin@example.org
# At least 8 characters with a letter and a number
ADMIN_PASSWORD=CHANGE_ME
ADMIN_FULL_NAME=AapdaSaathi Administrator
ADMIN_PHONE=9000000000

# --- Demo accounts for presentations (read only by: python -m app.database.seed_demo) ---
# Never set these in production; the script refuses to run when ENVIRONMENT=production.
DEMO_RESIDENT_EMAIL=resident.demo@example.org
DEMO_RESIDENT_PASSWORD=CHANGE_ME
DEMO_VOLUNTEER_EMAIL=volunteer.demo@example.org
DEMO_VOLUNTEER_PASSWORD=CHANGE_ME
